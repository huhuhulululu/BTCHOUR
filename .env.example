# paper (default) never talks to authenticated Kalshi trading endpoints.
BTCHOUR_MODE=paper

# lock = only decided contracts (σ≥3.2, p≥99.8%) with if-win ≥ 20%.
# hold / flex / scalp are the older playbooks.
BTCHOUR_PLAYBOOK=lock
BTCHOUR_TARGET_PROFIT=0.20
BTCHOUR_MIN_WIN_PROB=0.998
BTCHOUR_MIN_EXPECTED_ROI=0.20
BTCHOUR_MIN_SIGMA=3.2
BTCHOUR_ANNUAL_VOL=0.55
BTCHOUR_POLL_SECONDS=5
BTCHOUR_MAX_CONTRACTS=10
BTCHOUR_MAX_NOTIONAL=25
BTCHOUR_HOURLY_ONLY=1
BTCHOUR_SCAN_15M=1
BTCHOUR_SCAN_DAILY=1
BTCHOUR_SCAN_WEEKLY=1
# Rest $0.83 on decided contracts. Paper does not count a rest as a fill.
BTCHOUR_ALLOW_MAKER=1
BTCHOUR_ALLOW_EARLY_EXIT=0

# Older flex/scalp knobs (ignored by lock unless you switch playbooks).
BTCHOUR_SCALP_MIN_P=0.60
BTCHOUR_SCALP_MIN_GAP=0.10
BTCHOUR_SCALP_MAX_ENTRY=0.65
BTCHOUR_SCALP_MIN_SECONDS=600
BTCHOUR_SCALP_MAX_LOCK=0.90
BTCHOUR_INVALIDATE_P=0.40
BTCHOUR_FLATTEN_SECONDS=40

# Live trading (ignored in paper mode). Never commit real keys.
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=
KALSHI_PRIVATE_KEY=
KALSHI_DEMO=0
