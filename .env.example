# paper (default) never talks to authenticated Kalshi trading endpoints.
BTCHOUR_MODE=paper

# flex = lock_hold first, then swing_t 做T, then lock_wait.
# swing = only fast T clips. lock = only decided 20% coupons.
BTCHOUR_PLAYBOOK=flex
BTCHOUR_TARGET_PROFIT=0.20
BTCHOUR_MIN_WIN_PROB=0.95
BTCHOUR_MIN_EXPECTED_ROI=0.20
BTCHOUR_MIN_SIGMA=3.2
BTCHOUR_LOCK_MIN_P=0.998
BTCHOUR_ANNUAL_VOL=0.55
BTCHOUR_POLL_SECONDS=3
BTCHOUR_MAX_CONTRACTS=10
BTCHOUR_MAX_NOTIONAL=25
BTCHOUR_HOURLY_ONLY=1
BTCHOUR_SCAN_15M=1
BTCHOUR_SCAN_DAILY=1
BTCHOUR_SCAN_WEEKLY=1
# Rest $0.83 on decided contracts. Paper does not count a rest as a fill.
BTCHOUR_ALLOW_MAKER=1
BTCHOUR_ALLOW_EARLY_EXIT=1

# 做T / short swing
BTCHOUR_SWING_MIN_P=0.55
BTCHOUR_SWING_MIN_GAP=0.08
BTCHOUR_SWING_MIN_ASK=0.18
BTCHOUR_SWING_MAX_ASK=0.72
BTCHOUR_SWING_MIN_SECONDS=180
BTCHOUR_SWING_TARGET=0.10
BTCHOUR_SWING_MAX_CLIP=0.50
BTCHOUR_SWING_TRAIL=0.04
BTCHOUR_SWING_RUNNER_GAP=0.12
BTCHOUR_SWING_MAX_DISTANCE=600
BTCHOUR_SWING_FADE=0.12
BTCHOUR_SWING_STOP=0.12
BTCHOUR_SKIP_AFTER_LOSS=1
BTCHOUR_IMPULSE_MIN=100
BTCHOUR_IMPULSE_MIN_P=0.52
BTCHOUR_IMPULSE_MIN_GAP=0.02
BTCHOUR_IMPULSE_MAX_ASK=0.52
# 014: hang only on a same-way |impulse|≥$100 dump/rally; do not send live_one until a real dump.
BTCHOUR_IMPULSE_WAIT_REST_MIN=100
# 017: a filled coupon is carried to settlement. No t_clip / t_trail / t_wait_stop /
# t_scratch / lock_on_book / TWAP flatten on it. Set 0 for the pre-017 clip stack.
BTCHOUR_IMPULSE_WAIT_HOLD=1
BTCHOUR_LIVE_ONE=0

# cushion_hold (016, proposal -- default OFF). The tape has already pushed spot >= N
# residual-vol sigmas off the rung while the book still asks 70-90c for that side.
# Taker in, hold to settlement: no clip band, no stop, no TWAP flatten.
# BTCHOUR_PLAYBOOK=edge turns it on alone; =flex plus BTCHOUR_CUSHION_HOLD=1 layers it.
BTCHOUR_CUSHION_HOLD=0
BTCHOUR_CUSHION_MIN=1.5
BTCHOUR_CUSHION_MIN_ASK=0.70
BTCHOUR_CUSHION_MAX_ASK=0.90
BTCHOUR_CUSHION_MAX_PER_HOUR=3
BTCHOUR_CUSHION_MIN_SECONDS=120

# Older scalp knobs (BTCHOUR_PLAYBOOK=scalp only).
BTCHOUR_SCALP_MIN_P=0.60
BTCHOUR_SCALP_MIN_GAP=0.10
BTCHOUR_SCALP_MAX_ENTRY=0.65
BTCHOUR_SCALP_MIN_SECONDS=600
BTCHOUR_SCALP_MAX_LOCK=0.90
BTCHOUR_INVALIDATE_P=0.40
BTCHOUR_FLATTEN_SECONDS=40

# Live trading (ignored in paper mode). Never commit real keys.
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=
KALSHI_PRIVATE_KEY=
KALSHI_DEMO=0
