# paper (default) never talks to authenticated Kalshi trading endpoints.
BTCHOUR_MODE=paper

# 20% if the contract settles in our favor, after estimated fees.
BTCHOUR_TARGET_PROFIT=0.20
BTCHOUR_MIN_WIN_PROB=0.95
# Min EV = p*b - (1-p) per unit stake.
BTCHOUR_MIN_EXPECTED_ROI=0.20
BTCHOUR_ANNUAL_VOL=0.55
BTCHOUR_POLL_SECONDS=10
BTCHOUR_MAX_CONTRACTS=10
BTCHOUR_MAX_NOTIONAL=25
BTCHOUR_HOURLY_ONLY=1
# Maker rest-at-20% quotes. Off by default so paper fills are only real crosses.
BTCHOUR_ALLOW_MAKER=0

# hold = only 20% EV hold-to-settle tickets.
# scalp = only markout clips that can lock 20% on the book.
# flex = prefer hold_edge, otherwise scalp; manage exits first.
BTCHOUR_PLAYBOOK=flex
BTCHOUR_SCALP_MIN_P=0.60
BTCHOUR_SCALP_MIN_GAP=0.10
BTCHOUR_SCALP_MAX_ENTRY=0.80
BTCHOUR_INVALIDATE_P=0.40
BTCHOUR_FLATTEN_SECONDS=40
BTCHOUR_ALLOW_EARLY_EXIT=1

# Live trading (ignored in paper mode). Never commit real keys.
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=
KALSHI_PRIVATE_KEY=
KALSHI_DEMO=0
