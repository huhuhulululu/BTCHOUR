__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
.env
.env.*
!.env.example
# git cannot re-include a path under an excluded directory, so exclude the
# contents of data/ rather than data/ itself.
data/*
# The tape archive is the one thing worth keeping: containers are ephemeral, so
# every backtest this repo has ever published rested on a sample nobody can re-run.
!data/archive/
*.pem
*.key
*RSA PRIVATE KEY*
*.orig
.DS_Store
